# Katalogi wejścia/wyjścia — dane użytkownika i wygenerowane wyniki (poza git),
# z zachowaniem plików .gitkeep, by puste katalogi przetrwały w repozytorium.
input/*
!input/.gitkeep
output/*
!output/.gitkeep
